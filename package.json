{
  "name": "stuberm/mongocli",
  "version": "0.1.0",
  "description": "MongoDB CLI with named connections",
  "license": "MIT",
  "type": "module",
  "bin": { "mongocli": "dist/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "bun": ">=1.0.0" },
  "scripts": {
    "cli": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "tsc": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": { "mongodb": "^6.0.0" },
  "devDependencies": { "@types/bun": "latest", "@types/node": "^22.15.21", "typescript": "^5.8.3" }
}
